# Every variable actually read by the codebase is documented here.
# Variables not listed are not read anywhere; model IDs are pinned as literals
# in code, never configured via environment.

# GCP project for Firestore and Cloud Run (read by the gateway, evidence
# service, and seed/audit scripts; defaults to hodi-2026 when unset).
GCP_PROJECT_ID=hodi-2026

# Optional canonical base URL override for the evidence endpoint. If set and
# DNS-resolvable it is advertised in robots.txt / sitemap.xml / hodi.json;
# otherwise the service falls back to the Cloud Run URL.
# HODI_BASE_URL=https://hodi.example.com

# Set to 1 to force the credential-free offline path (no Firestore client).
# `make demo` sets this itself; you never need it for normal operation.
# HODI_OFFLINE=1

# Set to 1 to record live Gemini responses into the committed response cache
# (fixtures/gemini_response_cache.json). Dev-only; never set in production.
# HODI_CACHE_WRITE=1

# Port the evidence service listens on (set by Cloud Run in production).
PORT=8080
