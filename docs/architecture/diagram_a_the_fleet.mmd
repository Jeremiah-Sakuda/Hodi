    classDef infra fill:#fff8e6,stroke:#b8860b,color:#111
    classDef note fill:#f3f3f3,stroke:#999,stroke-dasharray:4 3,color:#111

    class W1,W2,W3,W4 wall
    class RC,LN,EV,RP agent
