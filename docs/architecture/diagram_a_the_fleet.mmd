title: "Hodi — The Fleet: four conflict-domain agents + the consent arbiter, five conflict walls (every number on this diagram is read from /docs/metrics.json)"
---
flowchart TB

    REG["AGENT REGISTRY<br/>publish · version · discover · scope<br/>role-scoped discovery returns [ ] when unauthorized<br/>durable: publications fold over an append-only store"]

    GW["AGENT GATEWAY<br/>routing + policy enforcement<br/>every denial = structured PolicyDenialEvent, never silent<br/>enforces data access AND assertion authority (who may CLAIM what)"]

    REG --> GW

    subgraph ADK["ADK google-adk 2.6.2 — orchestration layer (src/fleet/adk_fleet.py)"]
        direction LR
        RC["RIGHTS CUSTODIAN<br/>artist identity, works, terms<br/>initiates revocation<br/>SA: rights-custodian-sa@"]
        LN["LICENSING NEGOTIATOR<br/>ONE counterparty per session<br/>SA: licensing-negotiator-sa@"]
        EV["EVIDENCE AGENT<br/>crawler logs, canaries<br/>never claims training membership<br/>SA: evidence-agent-sa@"]
        RP["REVOCATION PROPAGATOR<br/>signed notices + receipts<br/>SA: revocation-propagator-sa@"]
    end

    OTEL(["OTel exporter<br/>span per agent decision:<br/>agent.identity · policy.consulted · outcome<br/>one trace per delegation"])
    ADK -.exports.-> OTEL

    RC -. "discovers by role<br/>(registry permits)" .-> RP
    LN -. "discovery DENIED<br/>returns [ ]" .-x RP

    GW --> RC
    GW --> LN
    GW --> EV
    GW --> RP

    ARB["CONSENT ARBITER<br/>adjudicates incidents from TYPED ASSERTIONS ONLY<br/>holds NONE of the four domains · NO write to grant history<br/>deterministic → decision reproducible by hodi verify<br/>SA: consent-arbiter-sa@"]

    W1["🧱 WALL<br/>other buyers' terms"]
    W2["🧱 WALL<br/>commercial terms"]
    W3["🧱 WALL<br/>artist identity"]
    W4["🧱 WALL<br/>buyer terms"]
    W5["🧱 WALL<br/>identity · terms · evidence · grant history<br/>(the arbiter reads none of them)"]

    LN --x W1
    EV --x W2
    RP --x W3
    RC --x W4
    ARB --x W5

    LOG[("APPEND-ONLY GRANT-EVENT LOG (Firestore)<br/>grants · scopes · revocations · receipts<br/>create()-only custom IAM role — no update, no delete<br/>state = fold: resolve(grant_id, at=t)")]

    RC --> LOG
    LN --> LOG
    EV --> LOG
    RP --> LOG

    SUP["SUPERVISOR<br/>deadline 5.0 s (derived from observed p95 2939 ms, ×1.7 headroom — metrics.json)<br/>quarantine · reroute · circuit-break · TaskAbandoned"]
    SUP -.bounds.-> ADK

    subgraph DEPLOYED["Cloud Run front door — hodi-evidence-endpoint (min-instances=0)"]
        API["BUYER API<br/>signed requests: X-Hodi-Key-Id / Timestamp / Signature<br/>HMAC over raw body; identity from the CREDENTIAL<br/>/api/v1/license · /api/v1/license/natural · /api/v1/revoke"]
        PUB["PUBLIC SURFACES<br/>/.well-known/hodi.json · /robots.txt<br/>/works · /canaries · /evidence-counts"]
        CON["ARTIST CONSOLE (READ-ONLY)<br/>renders works, control tiers,<br/>evidence by class with no total<br/>revoke is NOT wired: it needs an artist<br/>credential a static SPA must not hold"]
    end

    subgraph DOMAINS["Private Cloud Run conflict-domain workloads — verified 2026-08-14"]
        DRC["RIGHTS CUSTODIAN<br/>hodi-identity"]
        DLN["LICENSING NEGOTIATOR<br/>hodi-commercial"]
        DEV["EVIDENCE AGENT<br/>hodi-evidence"]
        DAR["CONSENT ARBITER<br/>hodi-adjudication"]
    end
    RWORK["PRIVATE REVOCATION WORKER<br/>revocation-propagator-sa<br/>(default) only<br/>hardened cutover: NOT YET VERIFIED LIVE"]

    GEM(["GEMINI 3.5 FLASH via Vertex AI (global, temp 0, pinned)<br/>interprets natural language into a typed Scope<br/>THE MODEL INTERPRETS INTENT — THE LATTICE DECIDES PERMISSION"])
    GMA(["GEMMA gemma-4-26b-a4b-it-maas<br/>crawler-log triage: bot / human / unknown"])
    SCH["CLOUD SCHEDULER<br/>09:00 UTC accrual audit · 23:00 UTC teardown"]

    API --> GEM
    GEM -- "validated Scope only" --> GW
    API --> GW
    API --> DRC
    API --> DLN
    API --> DEV
    API --> DAR
    API -. "post-review cutover; unverified live" .-> RWORK
    CON -. reads .-> PUB
    PUB --> LOG
    EV --> GMA
    SCH -.triggers.-> PUB

    NOTE["No SA holds two of {identity, buyer terms, evidence, revocation}; the consent arbiter holds none.<br/>A monolith here would itself be the violation.<br/>Numbers trace to /docs/metrics.json.<br/>Identity, commercial, evidence and adjudication data were migrated to named databases<br/>and are served by private workloads under IAM-conditioned service accounts; the front door<br/>is refused by Google IAM on all four. The shared append-only grant log stays in (default),<br/>so counterparty row separation inside it remains gateway-enforced by design.<br/>Revocation-worker IAM hardening and route cutover are implemented but unverified live.<br/>Signing: Cloud KMS on the last verified deployment / labelled-ephemeral Ed25519 offline;<br/>hodi verify checks with the public key only."]

